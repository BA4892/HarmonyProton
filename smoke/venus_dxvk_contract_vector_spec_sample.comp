#version 450

/* DXVK-like specialization use: a bool SpecId feeds a vector select while
 * the sampler-first/formatless-storage descriptor contract stays unchanged. */
layout(constant_id = 0) const bool sourceBound = true;
layout(constant_id = 1) const bool outputBound = true;
layout(set = 0, binding = 0) uniform sampler sourceSampler;
layout(set = 0, binding = 1) uniform texture2D sourceTexture;
layout(set = 0, binding = 2) uniform writeonly image2D outputImage;
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    vec4 sampled = textureLod(
        sampler2D(sourceTexture, sourceSampler), vec2(0.125, 0.125), 0.0);
    bvec4 boundMask = bvec4(sourceBound);
    vec4 value = mix(vec4(0.0), sampled, boundMask);
    if (outputBound)
        imageStore(outputImage, ivec2(0, 0), value);
}
