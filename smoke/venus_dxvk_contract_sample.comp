#version 450

/* Golden control for the exact DXVK compute descriptor contract.  Keep the
 * binding order, descriptor types, local size, image formats and sampling
 * coordinates aligned with the failing DXVK CS replay; only the compiler and
 * shader body differ. */
layout(set = 0, binding = 0) uniform sampler sourceSampler;
layout(set = 0, binding = 1) uniform texture2D sourceTexture;
layout(set = 0, binding = 2, std430) buffer Output {
    uint value;
} outputBuffer;
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    vec4 value = textureLod(
        sampler2D(sourceTexture, sourceSampler), vec2(0.125, 0.125), 0.0);
    uvec4 color = uvec4(round(clamp(value, 0.0, 1.0) * 255.0));
    outputBuffer.value = color.x | (color.y << 8) | (color.z << 16) | (color.w << 24);
}
